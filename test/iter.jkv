type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func range(count I32) RangeIterator {
    r = new(RangeIterator)
    r.start = 0
    r.end = count-1
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func main() {

    sum = 0
    for i = range(2,5) {
        sum+=i
    }
    assert(sum==14)

    r = range(10, 15)
    sum = 0
    loop {
        i = next(r) else break
        sum+=i
    }
    assert(sum==75)

    sum = 0
    for i = range(2,5) {
        sum+=i
    }
    assert(sum==14)

    sum=0
    for i = range(2,5) {
        sum+=i
    }
    assert(sum==14)

    j=0
    sum=0
    loop {
       j=j+1
       sum+=j
       if j>5 : break
    }
    assert(sum==21)

    sum=0
    for i = range(2,5) {
        sum+=i
    }
    assert(sum==14)

    for i = range(12,15) {
        sum+=i
    }
    assert(sum==68)

    r = range(10, 15)
    sum = 0
    loop {
        i = next(r) else break
        sum+=i
        fflush()
    }
    assert(sum==75)

    sum=0
    for i=range(5) {
        sum+=i
    }
    assert(sum==10)

    // Testing nested iterations
    sub = "-file="
    filename=""
    ok = true
    sum=0
    for i=range(1,3) {
        for k=range(1,4) {
            sum=sum+i*k
        }
    }
    assert(sum==60, "Failed sum")
}
