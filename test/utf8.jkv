const UTF8_ACCEPT U8 = 0
const UTF8_REJECT U8 = 1

func decode_byte(state I32, codep I32, byte U8)  I32, I32 {
    kind = utf8d[byte]
    if state != UTF8_ACCEPT {
        codep = (byte & 0x3f) | (codep << 6)
    } else {
        codep = (0xff >> kind) & byte
    }
    state = utf8d[256 + state*16 + kind]
    return codep, state
}

