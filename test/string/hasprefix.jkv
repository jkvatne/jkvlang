
type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func has_prefix(s String, sub String) Bool {
    if len(sub)>len(s) ? return false
    ok = true
    for j=range(0, len(sub)-1) {
        if s[j]!=sub[j] {
            // NB: Can not return here. Does not support return from inner loops
            ok=false
            break
        }
    }
    return ok
}

func main() {
    s = "-file=test"
    assert(has_prefix(s, "-sile"), "Intentionaly failed: Expected has_prefix(s, '-sile') to be false")
    invert_err()
    assert(!has_prefix(s, "xxxxx"), "Expected !has_prefix(s, 'xxxxx') to be true")
    assert(!has_prefix(s, "-aaaaaaaaaaaaaaaa"), "Failed -aaaaaaaaaaaaaa")
    assert(has_prefix(s, "-file"), "Failed -file")
    assert(has_prefix(s, "-f"), "Failed -f")
    assert(has_prefix(s, "-file"), "Failed not -file=x")
    assert(!has_prefix(s, "-sile"), "Failed -sile")
    assert(has_prefix(s, "-file"), "Failed not -sile")

}

