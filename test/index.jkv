type State = struct {
    token I32
    ch1   U8
    ch2   U8
    text String
    size I32
    p I32
}

type RangeIterator = struct {
    start I32
    end I32
}

func main() {
    n = 1
    t = "-file=test"
    s = new(State)
    s.text = "-file=abcdefg"

    // Test len()
    s.size = len(s.text)
    assert(s.size==13, "Expected s.size==13, got %d", s.size)

    // Test len("")
    n = len("")
    assert(n==0, "Expected n==0, got %d", n)

    s.p=6
	s.ch1 = s.text[s.p]
	assert(s.ch1==0x61, "Expected s.ch1=0x61, got 0x%x", s.ch1)

    s.text[1]='g'
    assert(s.text=="-gile=abcdefg", "Expected s.text=='-gile=abcdefg', got %s", s.text)

    s.p=1
    s.text[s.p] = 'h'
    assert(s.text=="-hile=abcdefg", "Expected s.text=='-gile=abcdefg', got %s", s.text)

    t[6]='T'
    assert(t=="-file=Test", "Expected t=='-file=Test', got '%s'", t)

    i=6
    t[i]='X'
    assert(t=="-file=Xest", "Expected t=='-file=Xest', got '%s'", t)

}