
type Person = struct{
    id I64
    name String
    Age U8
}

func main () {
    s = "Hello "
    t = "World"

    // Index
    k = s[1]
    assert(k==0x65)

    // Test concat three strings and assign to local variable
    w = s+t
    assert(w=="Hello World", "Failed concat")
    assert(s=="Hello ", "Failed access to old s")

    // Calling len
    ll = len(w)
    assert(ll==11, "Failed len test 1")
    assert(len(w)==11, "Failed len test 2")

    // Update indexed character. Will move s to writeable memory
    s[2] = 'x'
    assert(s=="Hello ", "Intentionally failed Hello test")
    assert(s=="Hexlo ", "Failed Hexlo test")

    p = new(Person)
    p.name="Jan Kåre Vatne"
    assert(p.name=="Jan Kåre Vatne", "Name failed")
    assert(p.name=="Jxn Kåre Vatne", "Intentionaly name failed")
    assert(p.name=="Jan Kåre Vatne..", "Intentionaly name failed on length")

}