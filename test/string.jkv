
func main () {
    s = "Hello "
    t = "World"

    // Index
    k = s[1]
    assert(k==0x65)

    // Test concat three strings and assign to local variable
    w = s+t
    assert(w=="Hello World", "Failed concat")
    assert(s=="Hello ", "Failed access to old s")

    // Calling len
    ll = len(w)
    assert(ll==11)
    assert(len(w)==11)

    // Update indexed character. Not allowed since s is a constant string.
    //s[2] = 0x64
    print("%s", s)
}