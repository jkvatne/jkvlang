
type Person = struct {
  adr String
  name String
}

func main() {
    p = new(Person)

    //=============================================
    // Test EmitAppendVariableExpressionStrStr
    //=============================================
    v = "Hello"
    w = "World"
    v += w
    assert(v=="HelloWorld", "Expected v=HelloWorld, got '%s'", v)

    //=============================================
    // Test EmitAppendVariableConstStrStr
    //=============================================
    s =  "aaa"
    s += "xxx"
    assert(s=="aaaxxx", "Expected 'sssxxx', got %s", s)

    //=============================================
    // Test EmitAppendIndirectExpressionStrStr
    //=============================================
    p.name = "Jan"
    w = "Vatne"
    p.name+=w
    assert(p.name=="JanVatne", "Expected p.name=JanVatne, got '%s'", p.name)

    //=============================================
    // Test EmitAppendIndirectConstStrStr
    //=============================================
    p.name = "Jan"
    p.name += "Vatne"
    assert(p.name=="JanVatne", "Expected p.name=='JanVatne', got '%s'", p.name)

    p.name += "Vatne"
    assert(p.name=="JanVatneVatne", "Expeccted p.name=='JanVatneVatne', got '%s'", p.name)
    //=============================================
    // Test EmitAssignVariableExpressionStrStr
    //=============================================
    q = w
    assert(q=="Vatne", "Expected q=='Vatne', got '%s'", q)

    //=============================================
    // Test EmitAssignIndirectExpressionStrStr
    //=============================================
    p.name = w
    assert(p.name=="Vatne", "Expected p.name=='Vatne', got '%s'", p.name)

    //=============================================
    // Test EmitAssignIndirectConstStrStr
    //=============================================
    p.name += " Vatne"
    assert(p.name=="Vatne Vatne", "Epected p.name=='Vatne Vatne', got '%s'", p.name)

    //=============================================
    // EmitAppendVariableExpressionStrChar
    //=============================================
    n = 'A'
    v += n+1
    assert(v=="HelloWorldB", "Expected p.name=HelloWorldB, got '%s'", v)

    b = ""
    b += 'H'
    assert(b=="H", "Expected b='H', got '%s'", b)
    b += 'G'
    assert(b=="HG", "Expected b='HG', got '%s'", b)

    v += 'e'
    assert(v=="HelloWorldBe", "Expected v='HelloWorldBe', got '%s'", v)

    ch = 'e'
    v += ch
    assert(v=="HelloWorldBee", "Expected v='HelloWorldBee', got '%s'", v)

    //=============================================
    // EmitAppendIndirectConstStrChar
    //=============================================
    p.name = "Jan"
    p.name += 'X'
    assert(p.name=="JanX", "Expected p.name='JanX', got '%s'", p.name)

    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    assert(p.name=="JanXXXXXXX", "Expected p.name='JanXXXXXXX', got '%s'", p.name)

    //=============================================
    // Test EmitAppendIndirectExpressionStrChar
    //=============================================
    ch = U8(0x58)
    p.name += ch
    assert(p.name=="JanXXXXXXXX", "Expected p.name=='JanXXXXXXXX', got '%s'", p.name)

    //=============================================
    // Concatenate two literals
    //=============================================
    s = "Hello"
    t = "World"
    u = s+t
    assert(u=="HelloWorld", "Expected u='HelloWorld', got '%s'", u)

    //=============================================
    // Retesting code that failed previously
    //=============================================
    v = "Hello"
    w = "World"
    v += w
    s =  "aaa"
    p.name = "Jan"
    p.name+=w
    assert(p.name=="JanWorld", "Expected p.name=JanWorld, got '%s'", p.name)

    //=============================================
    // Retesting code that failed previously because
    // of corrupted dx in ExtendStringCapacity
    //=============================================
    id = ""
    id += '1'
    id += '2'
    id += '3'
    id += '4'
    id += '5'
    id += '6'
    id += '7'
    id += '8'
    id += '9'
    id += '0'
    id += '1'
    id += '2'
    id += '3'
    id += '4'
    id += '5'
    id += '6'
    id += '7'
    id += '8'
    id += '9'
    id += '0'
    id += '1'  // Fails nr 21. Free string panics.
    assert(id=="123456789012345678901", "Expected 123456789012345678901, got %s", id)

}