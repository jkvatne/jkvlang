type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func range(count I32) RangeIterator {
    r = new(RangeIterator)
    r.start = 0
    r.end = count-1
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func main() {

    r = new(RangeIterator)
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    assert(r.start==1, "Expected r.start=1, got %d", r.start)

    sum = I32(0)
    for i = range(2,5) {
        sum+=i
    }
    assert(sum==14, "Expected sum==14, got %d", sum)

    ra = range(10, 15)
    sum = 0
    loop {
        i = next(ra) else break
        sum+=i
    }
    assert(sum==75, "Expected sum==75, got %d", sum)

    sum = 0
    for i = range(2,5) {
        sum+=i    }
    assert(sum==14)

    sum=0
    for i = range(2,7) {
        sum+=i
    }
    assert(sum==21, "Expected sum==21, got %d", sum)


    j=0
    sum=0
    loop {
       j=j+1
       sum+=j
       if j>5 : break
    }
    assert(sum==21, "Expected sum==21, got %d", sum)

    sum=0
    for i = range(1,5) {
        sum+=i
    }
    assert(sum==15, "Expected sum==15, got %d", sum)


    for i = range(12,15) {
        sum+=i
    }
    assert(sum==68, "Expected sum==68, got %d", sum)

/* This leaks. break not handled good enough
    ra = range(10, 15)
    sum = 0
    loop {
        i = next(ra) else break
        sum+=i
        fflush()
    }
    assert(sum==75, "Expected sum==75, got %d", sum)
*/
    sum=0
    for i=range(5) {
        sum+=i
    }
    assert(sum==14, "Expected sum==14, go %d", sum)

    // Testing nested iterations
    sub = "-file="
    filename=""
    ok = true
    sum=0
    for i=range(1,3) {
        for k=range(1,4) {
            ch = "asd"
            sum=sum+i*k
        }
    }
    assert(sum==60, "Failed sum, got %d", sum)

    // This code was leaking 17 bytes
    // because of id created inside loop
    ch = 'A'
    if true {
        id = ""
        id += ch
    }

}
