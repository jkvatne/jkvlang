type Rec = struct {
    intval I32
    float64val F64
    float32val F64
}

func main() {
    print ("Testing assignments")

    x = 1
    y = 2
    x = y
    assert(x==2, "Expected x==2, got %d", x)

    x+=2
    assert(x==4, "Expected x==4, got %d", x)

    x*=2
    assert(x==8, "Expected x==8, got %d", x)

    y = 2*x
    assert(y==16, "Expected y==16, got %d", y)

    y -= 7
    assert(y==9, "Expected y==9, got %d", y)

    y /=3
    assert(y==3, "Expected y==3, got %d", y)

    x64 = 2.0
    x64 += 3.0
    assert(x64==5.0, "Expected x64==5.0, got %f", x64)

    f = 1.0
    g = 2.0
    f = g
    assert(f==2.0, "Expected f=2.0 , got %f", f)

    r = new(Rec)
    r.intval = 123
    assert(r.intval==123, "Expected r.intval=123, got %d", r.intval)

    r.intval +=1
    assert(r.intval==124, "Expected r.intval=124, got %d", r.intval)

    u = 12
    r.intval = u
    assert(r.intval==12, "Expected r.intval=12, got %d", r.intval)

    // ========= 64 bit floats =================

    y64 = 3.0
    x64 = y64
    assert(x64==3.0, "Expected x64==3.0, got %f", x64)

    x64 = y64+5.0
    assert(x64==8.0, "Expected x64==8.0, got %f", x64)

    x64 += 5.0
    assert(x64==13.0, "Expected x64==13.0, got %f", x64)

    x64 -= 4.0
    assert(x64==9.0, "Expected x64==9.0, got %f", x64)

    x64 *= 1.5
    assert(x64==13.5, "Expected x64==13.5, got %f", x64)

    x64 /= 2.0
    assert(x64==6.75, "Expected x64==6.75, got %f", x64)

    x64 += y64
    assert(x64==9.75, "Expected x64==9.75, got %f", x64)

    x64 *= y64
    assert(x64==29.25, "Expected x64==29.25, got %f", x64)

    x64 /= y64
    assert(x64==9.75, "Expected x64==9.75, got %f", x64)

    x64 -= y64
    assert(x64==6.75, "Expected x64==6.75, got %f", x64)

    // ========= 32 bit floats =================
    x32 = F32(2.0)
    y32 = F32(3.0)

    x32 = y32
    assert(x32==3.0, "Expected x32==3.0, got %f", x32)

    x32 += F32(1.0)
    assert(x32==4.0, "Expected x32==4.0, got %f", x32)

    x32 = y32+5.0
    assert(x32==8.0, "Expected x32==8.0, got %f", x32)

    x32 *= F32(2.0)
    assert(x32==16.0, "Expected x32==16.0, got %f", x32)

    x32 -= F32(6.0)
    assert(x32==10.0, "Expected x32==10.0, got %f", x32)

    x32 += y32
    assert(x32==13.0, "Expected x32==13.0, got %f", x32)

    x32 *= y32
    assert(x32==39.0, "Expected x32==39.0, got %f", x32)

    x32 /= y32
    assert(x32==13.0, "Expected x32==13.0, got %f", x32)

    x32 -= y32
    assert(x32==10.0, "Expected x32==10.0, got %f", x32)

    r = new(Rec)
    r.intval=8
    r.float64val = 3.0
    r.float32val = 4.0

    r.intval +=1
    assert(r.intval==9, "Expected r.intval==9, got %d", r.intval)

    r.float64val += 1.0
    assert(r.float64val==4.0, "Expected r.float64val==4.0, got %f", r.float64val)

    r.float32val += 1.0
    assert(r.float32val==5.0, "Expected r.float32val==5.0, got %f", r.float32val)

    r.intval -=2
    assert(r.intval==7, "Expected r.intval==7, got %d", r.intval)

    r.float64val -= 2.0
    assert(r.float64val==2.0, "Expected r.float64val==2.0, got %f", r.float64val)

    r.float32val -= 3.0
    assert(r.float32val==2.0, "Expected r.float32val==2.0, got %f", r.float32val)

    r.float64val /= 2.0
    assert(r.float64val==1.0, "Expected r.float64val==1.0, got %f", r.float64val)

    r.float32val /= 2.0
    assert(r.float32val==1.0, "Expected r.float32val==1.0, got %f", r.float32val)

}