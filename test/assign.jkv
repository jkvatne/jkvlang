func main() {
    print ("Testing assignments")

    r = new(Rec)
    r.intval=8
    r.float64val = 3.0
    r.float32val = 4.0

    // Test assign expression to indirect integer value I32-Indir-Expr

    u = 12
    r.intval = u
    assert(r.intval==12, "Expected r.intval=12, got %d", r.intval)

    r.intval += u
    assert(r.intval==24, "Expected r.intval=24, got %d", r.intval)

    r.intval -= u
    assert(r.intval==12, "Expected r.intval=12 on -=, got %d", r.intval)

    r.intval *= u
    assert(r.intval==144, "Expected r.intval=144, got %d", r.intval)

    r.intval /= u
    assert(r.intval==12, "Expected r.intval=12 on /=, got %d", r.intval)

    // Test assign constant to int  I32-Indir-Const

    r.intval=8
    r.intval +=1
    assert(r.intval==9, "Expected r.intval==9, got %d", r.intval)

    r.intval *=2
    assert(r.intval==18, "Expected r.intval==18, got %d", r.intval)

    r.intval /=2
    assert(r.intval==9, "Expected r.intval==9, got %d", r.intval)

    r.intval -=3
    assert(r.intval==6, "Expected r.intval==6, got %d", r.intval)

    // Test assign constant to local variable  I32-Var-Const
    x = 1
    y = 2
    x = y
    assert(x==2, "Expected x==2, got %d", x)

    x+=2
    assert(x==4, "Expected x==4, got %d", x)

    x*=2
    assert(x==8, "Expected x==8, got %d", x)

    y = 2*x
    assert(y==16, "Expected y==16, got %d", y)

    y -= 7
    assert(y==9, "Expected y==9, got %d", y)

    y /=3
    assert(y==3, "Expected y==3, got %d", y)

    // Test assign expression to local integer variable I32-Var-Expr

    x = 1
    x += u
    assert(x==13, "Expected x=13, got %d", u)

    x -= u
    assert(x==1, "Expected x=1, got %d", u)

    x *= u
    assert(x==12, "Expected x=12, got %d", u)

    x /= u
    assert(x==1, "Expected x=1 on /=u, got %d", u)

    // Test assign const float64 to variable F64-Var-Const

    x64 = 2.0
    x64 += 3.0
    assert(x64==5.0, "Expected x64==5.0, got %f", x64)

