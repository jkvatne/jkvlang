    // Test F32-Indir-Expr
    r.float32val = 3.0

    w = F32(5.0)

    r.float32val += w
    assert(r.float32val==8.0, "Expected r.float32val==8.0, got %f", r.float32val)

    r.float32val -= w
    assert(r.float32val==3.0, "Expected r.float32val==3.0 on -=, got %f", r.float32val)

    r.float32val = 5.0
    r.float32val /= w
    assert(r.float32val==1.0, "Expected r.float32val==1.0, got %f", r.float32val)

    r.float32val *= w
    assert(r.float32val==5.0, "Expected r.float32val==5.0 on *=2, got %f", r.float32val)
