
func main() {

    v = call(GetKeyState, 17)  // Get ctrl key state. Should be 0 or 1.
    assert(v==0 || v==1, "Ctrl key state was %d", v)

    fn1 = "./test1.txt"
    f1 = call(CreateFileA, cptr(fn1), 0xc0000000, 0,0, 4, 128, 0)
    assert(f1>0, "Expected valid handle, got %x", f1)

    fn2 = "./test2.txt"
    f2 = call(CreateFileA, cptr(fn2), 0xc0000000, 0,0, 4, 128, 0)
    assert(f1>0, "Expected valid handle, got %x", f2)

    text = "Hello World!"
    n = I32(0)
    ok = call(WriteFile, f1, cptr(text), 13, ptr(n), 0)
    assert(ok==1, "Expected ok==1, got ok=%x", ok)
    assert(n==13, "Expected n=13, got n=%d", n)

    ok = call(WriteFile, f2, cptr(text), 13, ptr(n), 0)
    assert(ok==1, "Expected ok==1, got ok=%x", ok)
    assert(n==13, "Expected n=13, got n=%d", n)

    ok = call(CloseHandle, f1)
    assert(ok==1, "Expected close(f1) to return ok==1, got ok=%x", ok)

    ok = call(CloseHandle, f2)
    assert(ok==1, "Expected close(f2) to return ok==1, got ok=%x", ok)

}