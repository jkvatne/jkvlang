
type Person = struct {
  adr String
  name String
}

func main() {
    // Test EmitAppendVariableExpressionStrStr
    v = "Hello-"
    p = new(Person)
    v = "Hello"
    p.name = v  // Needed
    v = "Hello"

    w = "World"
    p.name = "Jan Kåre"
    n = 'A'

   // EmitAssignIndirectConstStrChar
   p.name += 'X'
   print("%s", p.name)


    // Test EmitAssignVariableExpressionStrStr
    v += w
    assert(v=="HelloWorld", "Expected v=HelloWorld, got '%s'", v)

    // Test EmitAssignIndirectConstStrStr
    p.name += " Vatne"
    //assert(p.name=="Jan Kåre Vatne", "Epected p.name==Jan Kåre, got '%s'", p.name)


    // EmitAssignVariableExpressionStrChar
    v += n+1
    assert(v=="HelloWorldB", "Expected p.name=HelloWorldB, got '%s'", v)

    v = ""
    v += 'H'
    assert(v=="H", "Expected v='H', got '%s'", v)

    v += 'e'
    assert(v=="He", "Expected v='He', got '%s'", v)

    ch = 'e'
    v += ch
    assert(v=="Hee", "Expected v='Hee', got '%s'", v)

    // Concatenate two literals
    s =  "aaa"
    s += "xxx"
    assert(s=="aaaxxx", "Expected 'sssxxx', got %s", s)

    // Concatenate rw string with litteral
    t = "Hello"
    u = s+t
    assert(u=="aaaxxxHello", "Expected u='xxxHello', got '%s'", u)

    // Test concat two strings and assign to local variable
    s = "Hello"
    t = "World"
    w = s+t
    assert(w=="HelloWorld", "Failed concat, got %s", w)


}