

func main() {
    s =  new(String,32)
    s = s + "xxx"
    assert(s=="xxx", "Expected s='xxx', got '%s'", s)

    t = "Hello"
    u = s+t
    assert(u=="xxxHello", "Expected u='xxxHello', got '%s'", u)

