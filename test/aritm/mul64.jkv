
type U64arr = []U64

const pow U64arr = {
  0x1234,  0x8000000000000000, 0, 1,
}

func main() {
    x = U64(0x700000002)
    y = U64(0x600000003)
    hi,lo = mul64(x,y)
    assert(hi==0x2a,"Expected hi==0x2a, got %d", hi)
    assert(lo==0x2100000006,"Expected lo==0x2100000006, got 0x%llx", lo)

    x = U64(5)
    y = U64(6)
    hi,lo = mul64(x,y)
    assert(hi==0,"Expected hi==0, got %d", hi)
    assert(lo==30,"Expected lo==30, got %d", lo)

    print("%016llx", pow[1])
    assert(pow[1]==0x8000000000000000)

}