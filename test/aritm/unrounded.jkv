package unrounded

import fmt

type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func range(count I32) RangeIterator {
    r = new(RangeIterator)
    r.start = 0
    r.end = count-1
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

type I32arr = []I32
type U64arr = []U64
type F64arr = []F64
type StringArr = []String

//========================  TESTS ====================================================================

const pow10TestsP  I32arr = {0, 25, 72, -44}
const pow10TestsHi U64arr = {0x8000000000000000, 0x84595161401484a0, 0x90e40fbeea1d3a4b, 0xe45c10c42a2b3b06}
const pow10TestsLo U64arr = {                 0,                  0, 0x4376AA16B901CE32, 0x734765824883af95}
const pow10TestsPe I32arr = {                 1,                 84,                240,               -146}

const test_floats F64arr = {6.0, 6.25, 6.5, 6.75, 7.0, 7.5, 8.5}

const values F64arr = {1.234e1, 1.9999e-44, 2e123, 1e99, 1e-99, 1e100, 1e-100, 1.99e-99}
const results StringArr =  {"1.234000000000000e+001", "1.999900000000000e-044",
  "2.000000000000000e+123", "9.999999999999999e+098", "1.000000000000000e-099",
  "1.000000000000000e+100", "1.000000000000000e-100", "1.989999999999999e-099"}

func main() {
/*
    print("fmt.Unrounded floating point conversions")
    print("\n j    f     u  floor round½↓ round round½↑ ceil")
    j = 0
    loop {
        f = test_floats[j]
        uu = fmt.unround(test_floats[j])
        print("%2d %6.3f %3d %4d %6d %5d %5d %7d",
            j, f, uu, fmt.ufloor(uu), fmt.roundHalfDown(uu), fmt.round(uu), roundHalfUp(uu), fmt.uceil(uu))
        j+=1
        if j>=7 {break}
    }
*/
    assert(fmt.unround(6.0)==24, "Expected 24, got %d")
    assert(fmt.unround(6.25)==25, "Expected 25, got %d")
    assert(fmt.unround(6.50)==26, "Expected 26, got %d")
    assert(fmt.unround(6.75)==27, "Expected 27, got %d")
    assert(fmt.ufloor(fmt.unround(6.75))==6, "Expected 6")
    assert(fmt.roundHalfDown(fmt.unround(6.5))==6, "Expected 6")
    assert(fmt.round(fmt.unround(6.5))==6, "Expected 6")
    assert(fmt.roundHalfUp(fmt.unround(6.5))==7, "Expected 7")

    // Test div
    u = fmt.div(fmt.unround(15.1),U64(6))
    assert(u==11, "Expected u==11, got %d", u)
    assert(fmt.round(u)==3, "Expected round(u)==3, got %d", fmt.round(u))

    // Test right shift
    u = fmt.rsh(fmt.unround(15.1), 1)
    assert(u==31, "rsh(15.1)=%d", u)
    u = fmt.rsh(fmt.unround(15.1), 2)
    assert(u==15, "rsh(15.1)=%d", u)

    // Test fmt.nudge
    //print("\nTesting fmt.nudge")
    //print("    x        u  fmt.nudge(-1)↓  floor   ceil  fmt.nudge(+1)↑")
    u = fmt.unround(15.0)
    assert(fmt.ufloor(fmt.nudge(u,-1))==14)
    //print("%7.3f %7d %7d %7d %7d %7d", 15.0, u, fmt.ufloor(fmt.nudge(u,-1)), fmt.ufloor(u), fmt.uceil(u), fmt.uceil(fmt.nudge(u, 1)))
    u = fmt.unround(15.1)
    assert(fmt.ufloor(fmt.nudge(u,-1))==15)
    assert(fmt.uceil(fmt.nudge(u, 1))==16)
    //print("%7.3f %7d %7d %7d %7d %7d", 15.1, u, fmt.ufloor(fmt.nudge(u,-1)), fmt.ufloor(u), fmt.uceil(u), fmt.uceil(fmt.nudge(u, 1)))
    u = fmt.unround(15.9)
    assert(fmt.ufloor(fmt.nudge(u,-1))==15)
    //print("%7.3f %7d %7d %7d %7d %7d", 15.9, u, fmt.ufloor(fmt.nudge(u,-1)), fmt.ufloor(u), fmt.uceil(u), fmt.uceil(fmt.nudge(u, 1)))
    u = fmt.unround(16.0)
    assert(fmt.ufloor(fmt.nudge(u,-1))==15)
    assert(fmt.uceil(fmt.nudge(u, 1))==17)
    //print("%7.3f %7d %7d %7d %7d %7d", 16.0, u, fmt.ufloor(fmt.nudge(u,-1)), fmt.ufloor(u), fmt.uceil(u), fmt.uceil(fmt.nudge(u, 1)))
    // print("\nTest log2Pow10")
    l =fmt.log2Pow10(0)
    assert(l==0, "Expected 0 got %d",l)
    l =fmt.log2Pow10(25)
    assert(l==83, "Expected 83 got %d",l)
    l =fmt.log2Pow10(72)
    assert(l==239, "Expected 239 got %d",l)
    l =fmt.log2Pow10(-44)
    assert(l==-147, "Expected -147 got %d",l)

/* Imported constants not yet implemented
    // Test fmt.pow10Tab
    n = 251
    hi = fmt.pow10Tab[n*2]
    lo = fmt.pow10Tab[n*2+1]
    assert(hi==0xdab99e59958885c5, "Expected hi=0xdab99e59958885c5")
    assert(lo==0x16a054c971ba1312, "Expected lo=0x16a054c971ba1312")
    //print("n=%d, hi=0x%016llx, lo=0x%016llx", n, hi, lo)

    n = 348
    hi = fmt.pow10Tab[n*2]
    lo = fmt.pow10Tab[n*2+1]
    assert(hi==0x8000000000000000, "Expected hi=0x8000000000000000")
    assert(lo==0x0000000000000000, "Expected lo=0x0000000000000000")
    //print("n=%d, hi=0x%016llx, lo=0x%016llx", n, hi, lo)
*/

    // print("Testing fmt.prescale")
	for i=range(0,3) {
	    p = pow10TestsP[i]
	    pmhi = pow10TestsHi[i]
	    pmlo = pow10TestsLo[i]
	    pe = pow10TestsPe[i]
	    // print("i=%d p=%lld, pe=%d", i, p, pe)
	    // print("pmhi=0x%016llx, pmlo=0x%016llx", pmhi, pmlo)
	    l = fmt.log2Pow10(p)
	    c = fmt.prescale(0, p, l)
		px = -(c.s + 2)
        //print("Got  px=%ll, c.hi=0x%016llx, c.lo=0x%016llx, l=%d", px, c.hi, c.lo, l)
        assert(pmhi==c.hi, "Expected pmhi==c.hi")
        assert(pmlo==c.lo, "Expected pmlo==c.lo")
        assert(px==pe, "Expected px==pe")
	}

	u = fmt.Unrounded(493599)
	v = fmt.round(u)
	assert(v==123400, "Expected round(493599)==123400, got %d", v)
	// print("fmt.Unrounded(493599)=%d, round(u)=%d", u, v)

    // Test len64()
    m = U64(0)
    assert(fmt.len64(m)==0,"len(%d) was %d", m, fmt.len64(m))
    m = U64(1)
    assert(fmt.len64(m)==1,"len(%d) was %d", m, fmt.len64(m))
    m = U64(3)
    assert(fmt.len64(m)==2,"len(%d) was %d", m, fmt.len64(m))
    m = U64(0xFF)
    assert(fmt.len64(m)==8,"len(%d) was %d", m, fmt.len64(m))
    m = U64(0x7FFF)
    assert(fmt.len64(m)==15,"len(%d) was %d", m, fmt.len64(m))
    m = U64(0xFFFFFFFFFFFFFFFF)
    assert(fmt.len64(m)==64,"len(%d) was %d", m, fmt.len64(m))

    // Test unpack(f)
    x = 1.75
    m,e = fmt.unpack64(x)
    assert(m==0xe000000000000000)
    assert(e==-63)

    f = 1.234
  	m, e = fmt.unpack64(f)
    assert(m==0x9df3b645a1cac000)
    assert(e==-63)

    // Test fmt.fixed_width
    print("")
    f = 1.234
    m,e = fmt.fixed_width(f, 6)
    //print("f=%0.6e, m=%5lld, e=%ld", f, m, e)
    assert(m == 123400 && e == -5, "Error formating 1.234, m=%llu, e=%d", m, e)

    f = 1.234E14
    m,e = fmt.fixed_width(f, 6)
    //print("f=%0.6e, m=%5lld, e=%ld", f, m, e)
    assert(m == 123400 && e == 9, "Error formating 1.234E14, m=%llu, e=%d", m, e)

    f = 1.234E-14
    m,e = fmt.fixed_width(f, 6)
    //print("f=%0.6e, m=%5lld, e=%ld", f, m, e)
    assert(m == 123400 && e == -19, "Error formating 1.234E-14, m=%llu, e=%d", m, e)

    f = 1.234E-99
    m,e = fmt.fixed_width(f, 6)
    //print("f=%0.6e, m=%5lld, e=%ld", f, m, e)
    assert(m == 123400 && e == -104, "Error formating 1.234E-99, m=%llu, e=%d", m, e)

    s = fmt.format_base10(U64(12345), 5)
    print("fmt.format_base10(12345, 5)=%s", s)

    print("----------")
    // In general, 17 fmt.digits are always enough to uniquely identify a float64
    for i=range(0, 7) {
        s = fmt.format(values[i], 16)  // 17 digts -> 16 decimals
        print("i=%d, fmt.format=%s", i, s)
        assert(s==results[i], "Expected %s, got %s", results[i], s)
    }

    print("fmt.digits(1)=%d", fmt.digits(U64(1)))
    print("fmt.digits(10)=%d", fmt.digits(U64(10)))
    print("fmt.digits(99)=%d", fmt.digits(U64(99)))
    print("fmt.digits(100)=%d", fmt.digits(U64(100)))
    print("fmt.digits(999)=%d", fmt.digits(U64(999)))
    print("fmt.digits(999999999999)=%d", fmt.digits(U64(999999999999)))


    d, p = fmt.shortest_fmt(1.234)
    print("\nd=%lld p=%d", d, p)
    s = fmt.fmt(d, p, fmt.digits(d))
    print("shortest=%s", s)
}
