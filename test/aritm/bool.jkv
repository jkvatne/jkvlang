type Unrounded = U64

func unround(x F64) Unrounded {
    b = true
    r = x | b
    return r
}


func main() {
    a = 4.0
    b = 5.0
    r = a==b
    print("%d", r)
    r = a!=b
    print("%d", r)

    x = 6.1
    f = floor(4*x)
    print("f=%f", f)
    b = f != 4*x
    print("f != 4*x=%d", b)
    // TODO: Do we need this?
    //z = f | b
    //print("z=%d", z)

    u = unround(x)
    print("u=%d", u)

    f = floor(4*x)
    b = f != 4*x
    print("b=%d", b)
}