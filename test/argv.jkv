const DONE I32 = 1

type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(DONE)
    x = r.start
    r.start = x+1
    return x
}

func main() {
    j = 0
    print("argc=%d", argc)
    print("Arg[j]=%s", args[j])
    print("Arg[0]=%s", args[0])
    print("")
    for i=range(0, argc-1) {
        print("Arg%d=%s", i, args[i])
    }
    print("\nEnvironment variables, count=%d", envc)

    for i=range(0, envc-1) {
        print("Env%d=%s", i, envs[i])
    }
    print("Done")
}
