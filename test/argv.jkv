
const DONE I32 = 1

type RangeIterator = struct {
    first I32
    last I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.first = start
    r.last = end
    return r
}

func range(count I32) RangeIterator {
    r = new(RangeIterator)
    r.first = 0
    r.last = count-1
    return r
}

func next(r RangeIterator) I32 {
    if r.first>r.last ? fail(DONE)
    x = r.first
    r.first = x+1
    return x
}

func main() {
    print("The number of arguments is %d", argc)

    for i=range(argc) {
        print("loop %d", i)
    }
    print("")

    for i=range(0, argc-1) {
        print("Arg%d=%s", i, args[i])
    }

    print("\nThe number of environment variables are %d", envc)
    for i=range(0, 3) {
        print("Env%d=%s", i, envs[i])
    }

    print("Done")
}
