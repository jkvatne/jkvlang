
type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func main() {
    x = 0
    print("\nStart")
    for i=range(0, 10) {
        print("Loop %d", i)
        id = ""
        // This will allocate 17 bytes, 8 size/cap, 1 content, 8 spare.
        id += 'A'
        if x>=4 {
            print("Break")
            break
        }
        x+=1
        print("x=%d", x)
    }
    print("Done")
}
