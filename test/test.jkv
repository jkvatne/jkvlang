type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func main() {
    ra = range(10, 15)
    sum = 0
    loop {
        i = next(ra) else break
        sum+=i
        print("i=%d sum=%d", i, sum)
    }
    assert(sum==75, "Expected sum==75, got %d", sum)
    print("\nfor i=range(2,5)")
    sum = 0
    for i = range(2,5) {
        sum+=i
        print("i=%d sum=%d", i, sum)
    }
    assert(sum==14, "Expected sum==14, got %d", sum)

}