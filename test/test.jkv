type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}


func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func main() {
    ch = 'A'
    for i=range(65, 68) {
        print("i=%d", i)
        // id = ""
