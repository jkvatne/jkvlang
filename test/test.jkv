type Name = struct {
    dummy String
    fname String
    ename String
}

type Info = struct {
    dummy String
    name  Name
}

type Person = struct {
    dummy String
    info Info
    age U8
}

func print_str(n Name,size I32) {
    print("print_str ename=%s  size=%d", n.ename, size)
}

func print_name(p Person, size I32) {
    print("print_name Name: %s %s, size=%d", p.info.name.fname, p.info.name.ename, size)
}

func main () {
    a = 1
    b = a
    assert(a==1&&b==1)

    p=new(Person)
    p.info=new(Info)
    p.info.name=new(Name)
    p.info.name.ename="Vatne"
    p.info.name.fname="Jan"
    print("Name: %s %s", p.info.name.fname, p.info.name.ename)
    p.print_name(10)
    p.info.name.print_str(11)

    assert(p.info.name.fname=="Jan")
    assert(p.info.name.ename=="Vatne")
}