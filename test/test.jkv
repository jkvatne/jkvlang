
type RangeIterator = struct {
    start I32
    end I32
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func main() {
    for i=range(0, 1) {
        for j=range(0, 3) {
            break
        }
    }
}