
type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func main() {
    //print("\nStart")
    ra = range(10, 15)
    sum = 0
    loop {
        i = next(ra) else break
        sum+=i
    }
    //print("Done, sum=%d", i)
}
