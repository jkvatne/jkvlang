
type Person = struct {
  adr String
  name String
}

func main() {
    p = new(Person)
    p.name = "Jan"
    // EmitAppendIndirectConstStrStr
    //p.name += "Kåre"
    //print("%s", p.name)

    // EmitAssignIndirectConstStrChar
    p.name += 'X'
    assert(p.name=="JanX", "Expected p.name='JanX', got '%s'", p.name)

    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    p.name += 'X'
    assert(p.name=="JanXXXXXXX", "Expected p.name='JanXXXXXXX', got '%s'", p.name)

}