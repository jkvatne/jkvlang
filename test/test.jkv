type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func main() {

    sum = 0
    for i = range(2,5) {
        sum+=i
     }
    assert(sum==14, "Expected sum=14, go %d", sum)

    sum = 0
    for i = range(3,6) {
        sum+=i
     }
    assert(sum==18, "Expected sum=18, go %d", sum)

    ra = range(10, 15)
    sum = 10
    loop {
        i = next(ra) else break
        sum+=i
    }
    assert(sum==85, "Expected sum==85, got %d", sum)
}