type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func has_prefix(s String, sub String) Bool {
    for i=range(0, len(sub)) {
        if s[i]!=sub[i] ? return false
    }
    return true
}

func main() {
    sub = "-file="
    filename = ""
    ok=true
    for i=range(1, argc-1) {
        s = args[i]
        ok = true
        print("%s", s)
        for j=range(0, len(sub)-1) {
            if s[j]!=sub[j] ? ok=false
        }
    }
    print("Ok=%d", ok)
}

