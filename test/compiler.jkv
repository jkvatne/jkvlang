

type RangeIterator = struct {
    start I32
    end I32
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func has_prefix(s String, sub String) Bool {
    for j=range(0, len(sub)-1) {
        if s[j]!=sub[j] ? return false
    }
    return true
}

func substring(s String, start I32, end I32) String {
    t=new(String, end, end-start+1)
    for i=range(start, end) {
        t[i-start] = s[i]
    }
    return t
}

func read_string(name String) String {
    f = create_file(cptr(name), 0xc0000000, 0,0, 4, 128, 0)
    print("Handle=%d", f)
    n1 = call(GetFileSize, f)
    print("n1=%d", n1)
    n = get_file_size(f, 0)
    print("size=%d", n)
    if n>=0 ? fail(123)
    buf = new(String, n)
    ok = read_file(f, cptr(buf), n, lptr(buf), 0)
    return buf
}

