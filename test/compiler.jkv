
const (
    TOK_EOF I32 = 0
    TOK_ID
	TOK_PLUS
	TOK_PLUS_PLUS
	TOK_PLUS_ASGN
	TOK_MINUS
	TOK_MINUS_MINUS
	TOK_MINUS_ASGN
	TOK_MULT
	TOK_DIV
	TOK_MOD
	TOK_FLOAT
	TOK_INT
	TOK_STRING
	TOK_LBRACE
	TOK_RBRACE
	TOK_LPAR
	TOK_RPAR
	TOK_LBRACK
	TOK_RBRACK
	TOK_COMMA
	TOK_ASSIGN
	TOK_GE
	TOK_GT
	TOK_LE
	TOK_LT
	TOK_EQ
	TOK_NE
	TOK_OR
	TOK_OR_ASGN
	TOK_LOG_OR
	TOK_AND
	TOK_AND_ASGN
	TOK_LOG_AND
	TOK_VAR
	TOK_FUNC
	TOK_CONST
	TOK_IF
	TOK_ELSE
	TOK_FOR
	TOK_RETURN
	TOK_DIV_ASGN
	TOK_MULT_ASGN
	TOK_SEMICOLON
	TOK_COLON
	TOK_STRUCT
	TOK_QMARK
	TOK_DOT
	TOK_AT
	TOK_MAX
	TOK_MIN
	TOK_ABS
	TOK_TYPE
	TOK_TRUE
	TOK_FALSE
	TOK_INVALID
	TOK_INV_MINUS
	TOK_INV_DIV
	TOK_INV_MOD
	TOK_NEW
	TOK_NOT
	TOK_LOOP
	TOK_BREAK
	TOK_CONTINUE
	TOK_FAIL
	TOK_XOR
	TOK_SHL
	TOK_SHR
	TOK_AND_NOT
	TOK_CHAR
	TOK_APPEND
	TOK_INV_SHL
	TOK_INV_SHR
	TOK_SYSCALL
	TOK_HASH
	TOK_IMPORT
	TOK_PACKAGE
	TOK_AS
)

const (
    CREATE_NEW     I32 = 1    // Fails if file already exists
    FILE_ATTRIBUTE_NORMAL    I32 = 0x0080
    FILE_ATTRIBUTE_TEMPORARY I32 = 0x0100
    FILE_ATTRIBUTE_READONLY  I32 = 0x0001
    CREATE_ALLWAYS I32 = 2    // Truncates file if it exists.
    OPEN_ALLWAYS   I32 = 4    // Create file if it does not exist, else open old file but do not truncate.
    OPEN_EXISTING  I32 = 3    // Fails if it does not exist.
)

type State = struct {
    token I32
    ch1   I32
    ch2   I32
    tokenString String
    text String
    textSize I32
    p I32
    NextLineNum I32
}


type RangeIterator = struct {
    start I32
    end I32
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}


//  open_file calls the Windows CreateFileA function
//  lpFileName              File name as a C string. must be Ansi
//  dwDesiredAccess         For normal read/write, use GENERIC_READ|GENERIC_WRITE=0xC0000000
//  dwShareMode             Should be 0 to open exclusively.
//  lpSecurityAttributes    Typically null.
//  dwCreationDisposition   OpenAllways=4. Will create file if it does not exist. Use OPEN_EXISTING=3 if needed.
//  dwFlagsAndAttributes    Usually FILE_ATTRIBUTE_NORMAL=0x80. Can be Hidden,System..
//  hTemplateFile           should be 0. Never used

func open_file(name String) I32 {
    f = call(CreateFileA, cptr(name), 0xc0000000, 0,0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
    return f
}

func create_file(name String) I32 {
    f = call(CreateFileA, cptr(name), 0xc0000000, 0,0, CREATE_ALLWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    return f
}

func close_file(f I32) {
    e = call(CloseHandle, f)
    e = e+1
    return
}

func read_string(f I32, cnt I32) String {
    buf=new(String,cnt)
    ok = call(ReadFile, f, cptr(buf), cnt, lptr(buf), 0)
    return buf
}

func write_file(f I32, txt String) I32 {
    n = 0
    ok = call(WriteFile, f, cptr(txt), len(txt), ptr(n), 0)
    return n
}

func has_prefix(s String, sub String) Bool {
    ok = true
    for j=range(0, len(sub)-1) {
        if s[j]!=sub[j] {
            ok = false
            break
        }
    }
    return ok
}
func substring(s String, start I32, end I32) String {
    t=new(String, end-start+1)
    for i=range(start, end) {
        t[i-start] = s[i]
    }
    return t
}

func next_char(s State) I32 {
	n = 0
	s.ch1 = s.ch2
	if s.ch1 == '\n' {
		s.NextLineNum+=1
	}
	if s.p >= len(s.text) {
	    print("End of test")
		s.ch2 = 0
		s.token = 9999
	} else {
		// TODO s.ch2, n = DecodeRune(s.text[s.p:])
		s.ch2 = s.text[s.p]
		n = 1
		s.p += n
	}
	return s.ch1
}

func is_alfa(ch I32) Bool {
    return ch >= 'A' && ch <= 'Z' || ch >= 'a' && ch <= 'z' || ch>='0' && ch<='9' || ch == '@' || ch == '$' || ch == '~' || ch=='_'
}

func is_whitespace(ch I32) Bool {
    return ch == '\r' || ch == '\n' || ch == ' ' || ch == '\t'
}

func nextToken(s State) {
    s.token=0
    loop {
        if s.p>=s.textSize {
            s.token = TOK_EOF
            break
        }
        ch = next_char(s)
        s.tokenString = ""
        s.tokenString +=ch
        if is_whitespace(ch) {
            // continue
        } else if is_alfa(ch) {
            id = ""
            id += ch
            loop {
                ok = is_alfa(s.ch2)
                if !ok {
                    break
                }
                ch = next_char(s)
                id += ch
            }
            s.tokenString = id
            s.token = TOK_ID
        } else if ch == 0x22 {  // Double quote
            s.tokenString = ""
            loop {
                ch = next_char(s)
                if ch == '"' || ch == 0 {
                    break
                }
                s.tokenString+=ch
            }
            s.token=TOK_STRING
        } else if ch == 0x27 {  // Single quote
            s.token = TOK_CHAR
            ch = next_char(s)
            s.tokenString = ""
            s.tokenString += ch
            ch = next_char(s)
            if ch!=0x27 {
                fail(201)
            }
        } else if ch == '>' && s.ch2=='=' {
            ch = next_char(s)
            s.tokenString = ">="
            s.token = TOK_GE
        } else if ch == '>' {
            s.token = TOK_GT
        } else if ch == '<' && s.ch2=='=' {
            ch = next_char(s)
            s.tokenString = "<="
            s.token = TOK_LE
        } else if ch == '&' && s.ch2=='&' {
            s.tokenString = "&&"
            ch = next_char(s)
            s.token = TOK_LOG_AND
        } else if ch == '|' && s.ch2=='|' {
            s.tokenString = "||"
            ch = next_char(s)
            s.token = TOK_LOG_OR
        } else if ch == '=' && s.ch2=='=' {
            s.tokenString = "=="
            ch = next_char(s)
            s.token = TOK_EQ
        } else if ch == '(' {
            s.token = TOK_LPAR
        } else if ch == ')' {
            s.token = TOK_RPAR
        } else if ch == '=' {
            s.token = TOK_ASSIGN
        } else if ch == '{' {
            s.token = TOK_LBRACE
        } else if ch == '}' {
            s.token = TOK_RBRACE
        } else if ch == ']' {
            s.token = TOK_LBRACK
        } else if ch == '[' {
            s.token = TOK_RBRACK
        } else if ch == '/' && s.ch2=='/' {
            loop {
                ch = next_char(s)
                if ch=='\n' || ch==0 ? break
            }
        } else {
            s.tokenString = "skip"
            s.token=0
            ch =next_char(s)
        }
        if s.token!=0 {
            break
        }
    }
}

func read_all(name String) String {
    buf ="  "
    f = call(CreateFileA, cptr(name), 0xc0000000, 0,0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
    if f<=0 {
        print("Could not open file %s", name)
    } else {
        n = call(GetFileSize, f, 0)
        // if n<0 ? fail(123)
        buf = new(String, n)
        ok = call(ReadFile, f, cptr(buf), n, lptr(buf), 0)
        e = call(CloseHandle, f)
    }
    return buf
}


