
type State = struct {
    token I32
    ch1   I32
    ch2   I32
    tokenString String
    text String
    textSize I32
    p I32
}

func nextChar(s State) {
	s.ch1 = s.text[s.p]
	s.p += 1
	s.ch2 = s.text[s.p]
}


type RangeIterator = struct {
    start I32
    end I32
}

func next(r RangeIterator) I32 {
    if r.start>r.end ? fail(1)
    x = r.start
    r.start = x+1
    return x
}

func range(start I32, end I32) RangeIterator {
    r = new(RangeIterator)
    r.start = start
    r.end = end
    return r
}

const (
    // dwCreationDisposition.
    CREATE_NEW     I32 = 1    // Fails if file already exists
    CREATE_ALLWAYS I32 = 2    // Truncates file if it exists.
    OPEN_ALLWAYS   I32 = 4    // Create file if it does not exist, else open old file but do not truncate.
    OPEN_EXISTING  I32 = 3    // Fails if it does not exist.

    FILE_ATTRIBUTE_NORMAL    I32 = 0x0080
    FILE_ATTRIBUTE_TEMPORARY I32 = 0x0100
    FILE_ATTRIBUTE_READONLY  I32 = 0x0001
)

//  open_file calls the Windows CreateFileA function
//  lpFileName              File name as a C string. must be Ansi
//  dwDesiredAccess         For normal read/write, use GENERIC_READ|GENERIC_WRITE=0xC0000000
//  dwShareMode             Should be 0 to open exclusively.
//  lpSecurityAttributes    Typically null.
//  dwCreationDisposition   OpenAllways=4. Will create file if it does not exist. Use OPEN_EXISTING=3 if needed.
//  dwFlagsAndAttributes    Usually FILE_ATTRIBUTE_NORMAL=0x80. Can be Hidden,System..
//  hTemplateFile           should be 0. Never used

func open_file(name String) I32 {
    f = call(CreateFileA, cptr(name), 0xc0000000, 0,0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
    return f
}

func create_file(name String) I32 {
    f = call(CreateFileA, cptr(name), 0xc0000000, 0,0, CREATE_ALLWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    return f
}

func close_file(f I32) {
    e = call(CloseHandle, f)
    e = e+1
    return
}

func read_string(f I32, cnt I32) String {
    buf=new(String,cnt)
    ok = call(ReadFile, f, cptr(buf), cnt, lptr(buf), 0)
    return buf
}

func write_file(f I32, txt String) I32 {
    n = 0
    ok = call(WriteFile, f, cptr(txt), len(txt), ptr(n), 0)
    return n
}

func read_all(name String) String {
    f = call(CreateFileA, cptr(name), 0xc0000000, 0,0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
    n = call(GetFileSize, f, 0)
    // if n>=0 ? fail(123)
    buf = new(String, n)
    ok = call(ReadFile, f, cptr(buf), n, lptr(buf), 0)
    close_file(f)
    return buf
}


func has_prefix(s String, sub String) Bool {
    for j=range(0, len(sub)-1) {
        if s[j]!=sub[j] ? return false
    }
    return true
}

func substring(s String, start I32, end I32) String {
    t=new(String, end, end-start+1)
    for i=range(start, end) {
        t[i-start] = s[i]
    }
    return t
}

const (
    TOK_EOF I32 = 0
)

func nextToken(s State) I32 {
    if s.p>=s.textSize {
        return 0
    }
    //nextChar(s)
    if s.ch1 == 13 {
        s.tokenString = "<cr>"
    } else if s.ch1 == 10 {
        s.tokenString = "<lf>"
    } else if s.ch1 == 9 {
        s.tokenString = "<tab>"
    }
}

func Parse(s State) {
    loop{
        token = nextToken(s)
        if token == 0 ? break
    }
}


func main() {
    filename = "compiler.jkv"
    s = new(State)
    s.text = "asd fad fad f a dsfad sfasdfadf"
    s.textSize = len(s.text)
    print("Text size=%d", s.textSize)

    filename=""
    for i=range(1, argc-1) {
        if has_prefix(args[i],"-file=") ?  filename=args[i]
    }
    print("Argument=%s",filename)
    u=substring(filename, 6, len(filename)-1)
    print("Filename=%s", u)

    filename = "compiler.jkv"
    s = new(State)
    s.text = read_all(filename)
    s.textSize = len(s.text)
    print("File size is %d bytes", s.textSize)
    Parse(s)

}

